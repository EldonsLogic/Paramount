# ── Login ──────────────────────────────────────────────────────────────
# The single account allowed to sign in.
AUTH_EMAIL=zaki.hussein@paramountcarat.com
# Password for that account. Choose a strong one and set it in Vercel → Settings → Environment Variables.
AUTH_PASSWORD=
# Random string (32+ chars) used to sign session cookies. Generate with: openssl rand -hex 32
AUTH_SECRET=

# ── Email (optional) ───────────────────────────────────────────────────
# Without these, the app still offers "Open in Outlook" (sent from your own mailbox).
# With them, a one-click "Send email" button appears, sending via Gmail.
# App password: https://myaccount.google.com/apppasswords (needs 2-Step Verification)
GMAIL_USER=
GMAIL_APP_PASSWORD=
# Every plan email is BCC'd here (comma-separate for several).
EMAIL_BCC=zaki.hussein@paramountcarat.com
